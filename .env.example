# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Any Gemini model that supports function calling
GEMINI_MODEL=gemini-3.8-flash
# minimal | low | medium | high: lower is faster, higher reasons more
GEMINI_THINKING_LEVEL=low
# Tried in order when the primary model returns 429 (free tier is ~20 requests/day per model)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
